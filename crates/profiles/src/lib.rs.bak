//! Vendor / OS profile boundary.
//!
//! The poller *never* branches on vendor. It calls `Profile::request` and
//! `Profile::parse` and writes whatever comes back. Adding a vendor = adding
//! a module here that impls `Profile` and registering it in `registry()`.

use netwatch_core::{oid::Oid, snmp_value::SnmpValue};
use std::sync::Arc;

pub use netwatch_core::model::{MetricDef, MetricKind, MetricReading, MetricValue};

pub struct DeviceContext<'a> {
    pub sys_object_id: &'a str,
    pub sys_descr: &'a str,
}

/// What to ask this round. `gets` are single-object reads (scalars, ending
/// in `.0`); `walks` are whole-column reads. The poller runs both.
#[derive(Debug, Clone, Default)]
pub struct PollRequest {
    pub gets: Vec<Oid>,
    pub walks: Vec<Oid>,
    /// Optional column groups; an empty or failed column stops its group.
    pub optional_walk_groups: Vec<Vec<Oid>>,
}

/// Everything the device said, keyed by the OID it answered with.
#[derive(Debug, Clone, Default)]
pub struct PollResponse {
    pub values: Vec<(Oid, SnmpValue)>,
}

impl PollResponse {
    pub fn get(&self, oid: &Oid) -> Option<&SnmpValue> {
        self.values.iter().find(|(o, _)| o == oid).map(|(_, v)| v)
    }

    pub fn walk<'a>(
        &'a self,
        root: &'a Oid,
    ) -> impl Iterator<Item = (&'a Oid, &'a SnmpValue)> + 'a {
        self.values
            .iter()
            .filter(move |(o, _)| root.is_prefix_of(o))
            .map(|(o, v)| (o, v))
    }

    /// ifIndex from a table row's OID. Assumes the last sub-id is the index.
    /// Wrong for tables with composite indexes; the profile must not use it
    /// for those.
    pub fn if_index_of(oid: &Oid) -> Option<u32> {
        oid.last()
    }
}

/// One MAC address learned on a switch port (ifIndex of the port).
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct MacSighting {
    pub mac: String,
    pub if_index: u32,
}

pub trait Profile: Send + Sync {
    fn name(&self) -> &'static str;
    fn detect(&self, ctx: &DeviceContext<'_>) -> bool;
    fn metrics(&self) -> &'static [MetricDef];
    fn request(&self, interfaces: &[netwatch_core::model::InterfaceRef]) -> PollRequest;
    fn parse(&self, resp: &PollResponse) -> Vec<MetricValue>;
    /// Bridge forwarding table, if the profile supports it. Default: none.
    fn parse_macs(&self, _resp: &PollResponse) -> Vec<MacSighting> {
        Vec::new()
    }
}

pub fn registry() -> Vec<Arc<dyn Profile>> {
    vec![
        Arc::new(cisco_ios::CiscoIos),
        Arc::new(cisco_nxos::CiscoNxos),
        Arc::new(mikrotik::MikroTik),
    ]
}

pub fn detect(ctx: &DeviceContext<'_>) -> Option<Arc<dyn Profile>> {
    registry().into_iter().find(|p| p.detect(ctx))
}

pub mod cisco_ios;
pub mod cisco_nxos;
pub mod mikrotik;

const OID_IF_HC_IN: &str = "1.3.6.1.2.1.31.1.1.1.6";
const OID_IF_HC_OUT: &str = "1.3.6.1.2.1.31.1.1.1.10";

const INTERFACE_COLUMNS: &[(&str, &str, bool)] = &[
    ("1.3.6.1.2.1.2.2.1.8", "if_oper_status", false),
    ("1.3.6.1.2.1.2.2.1.13", "if_in_discards", true),
    ("1.3.6.1.2.1.2.2.1.14", "if_in_errors", true),
    ("1.3.6.1.2.1.2.2.1.19", "if_out_discards", true),
    ("1.3.6.1.2.1.2.2.1.20", "if_out_errors", true),
    ("1.3.6.1.2.1.31.1.1.1.7", "if_hc_in_ucast_pkts", true),
    ("1.3.6.1.2.1.31.1.1.1.8", "if_hc_in_multicast_pkts", true),
    ("1.3.6.1.2.1.31.1.1.1.9", "if_hc_in_broadcast_pkts", true),
    ("1.3.6.1.2.1.31.1.1.1.11", "if_hc_out_ucast_pkts", true),
    ("1.3.6.1.2.1.31.1.1.1.12", "if_hc_out_multicast_pkts", true),
    ("1.3.6.1.2.1.31.1.1.1.13", "if_hc_out_broadcast_pkts", true),
];

