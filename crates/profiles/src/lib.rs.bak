/// ifHCIn/OutOctets column walks plus any profile-specific walks.
pub(crate) fn traffic_request(extra_walks: &[&str]) -> PollRequest {
    let mut walks = vec![
        Oid::parse(OID_IF_HC_IN).unwrap(),
        Oid::parse(OID_IF_HC_OUT).unwrap(),
    ];
    walks.extend(extra_walks.iter().map(|s| Oid::parse(s).unwrap()));
    PollRequest {
        gets: vec![],
        walks,
        optional_walk_groups: std::iter::once(
            [
                "1.3.6.1.2.1.25.2.3.1.2",
                "1.3.6.1.2.1.25.2.3.1.5",
                "1.3.6.1.2.1.25.2.3.1.6",
            ]
            .into_iter()
            .map(|s| Oid::parse(s).unwrap())
            .collect(),
        )
        .chain(
            INTERFACE_COLUMNS
                .iter()
                .map(|(oid, _, _)| vec![Oid::parse(oid).unwrap()]),
        )
        .collect(),
    }
}

/// RAM percentage from a single HOST-RESOURCES-MIB RAM storage row.
pub(crate) fn memory_used_pct(resp: &PollResponse) -> Option<MetricValue> {
    let types = Oid::parse("1.3.6.1.2.1.25.2.3.1.2").unwrap();
    let sizes = Oid::parse("1.3.6.1.2.1.25.2.3.1.5").unwrap();
    let used = Oid::parse("1.3.6.1.2.1.25.2.3.1.6").unwrap();
    let ram_type = Oid::parse("1.3.6.1.2.1.25.2.1.2").unwrap();
    let rows: Vec<_> = resp
        .walk(&types)
        .filter(|(oid, value)| {
            oid.0.len() == types.0.len() + 1
                && matches!(value, SnmpValue::ObjectIdentifier(kind) if *kind == ram_type)
        })
        .collect();
    if rows.len() != 1 {
        return None;
    }
    let index = rows[0].0.last()?;
    let unique = |oid: &Oid| {
        let mut values = resp.values.iter().filter(|(candidate, _)| candidate == oid);
        let first = values.next()?;
        if values.next().is_some() {
            None
        } else {
            first.1.as_u64()
        }
    };
    let size = unique(&sizes.child(index))?;
    let consumed = unique(&used.child(index))?;
    if size == 0 || consumed > size {
        return None;
    }
    Some(MetricValue {
        name: "memory_used_pct",
        interface_index: None,
        value: MetricReading::Gauge(consumed as f64 * 100.0 / size as f64),
    })
}
/// Per-interface traffic counters keyed by ifIndex.
pub(crate) fn traffic_metrics(resp: &PollResponse) -> Vec<MetricValue> {
    let mut out = Vec::new();
    for (root, name) in [
        (OID_IF_HC_IN, "if_hc_in_octets"),
        (OID_IF_HC_OUT, "if_hc_out_octets"),
    ] {
        let root = Oid::parse(root).unwrap();
        for (oid, value) in resp.walk(&root) {
            if oid.0.len() != root.0.len() + 1 {
                continue;
            }
            let (SnmpValue::Counter64(v), Some(if_index)) = (value, PollResponse::if_index_of(oid))
            else {
                continue;
            };
            out.push(MetricValue {
                name,
                interface_index: Some(if_index),
                value: MetricReading::Counter {
                    value: *v,
                    width: netwatch_core::counter::CounterWidth::Bits64,
                },
            });
        }
    }
    for (column, name, counter) in INTERFACE_COLUMNS {
        let root = Oid::parse(column).unwrap();
        for (oid, value) in resp.walk(&root) {
            if oid.0.len() != root.0.len() + 1 {
                continue;
            }
            let Some(if_index) = oid.last() else { continue };
            let reading = if *counter {
                match (value.as_u64(), value.counter_width()) {
                    (Some(value), Some(width)) => MetricReading::Counter { value, width },
                    _ => continue,
                }
            } else {
                match value.as_u64() {
                    Some(status @ 1..=7) => MetricReading::Gauge(status as f64),
                    _ => continue,
                }
            };
            out.push(MetricValue {
                name,
                interface_index: Some(if_index),
                value: reading,
            });
        }
    }
    out
}

/// First row of a gauge table, for devices whose "overall" CPU row is index 1.
pub(crate) fn first_row_gauge(
    resp: &PollResponse,
    root: &str,
    name: &'static str,
) -> Option<MetricValue> {
    let root = Oid::parse(root).unwrap();
    let (_, v) = resp.walk(&root).next()?;
    Some(MetricValue {
        name,
        interface_index: None,
        value: MetricReading::Gauge(v.as_u64()? as f64),
    })
}
