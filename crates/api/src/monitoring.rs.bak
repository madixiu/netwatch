use axum::{
    extract::{Path, Query, State},
    http::StatusCode,
    Json,
};
use chrono::{DateTime, Duration, Utc};
use netwatch_db::metrics::{self, MetricPoint, SeriesKind};
use serde::{Deserialize, Serialize};
use sqlx::PgPool;
use std::collections::HashMap;
 
use crate::{ApiError, AppState};
 
#[derive(sqlx::FromRow, Serialize)]
pub struct DeviceSummary {
    id: i64,
    name: String,
    mgmt_ip: String,
    vendor: String,
    model: Option<String>,
    profile: String,
    poll_interval_secs: i32,
    enabled: bool,
    status: String,
    last_poll: Option<DateTime<Utc>>,
    last_error: Option<String>,
}
 
async fn devices(pool: &PgPool, id: Option<i64>) -> Result<Vec<DeviceSummary>, sqlx::Error> {
    sqlx::query_as(
        "SELECT d.id, d.name, host(d.mgmt_ip) AS mgmt_ip, d.vendor, d.model, d.profile,
                d.poll_interval_secs, d.enabled,
                CASE WHEN NOT d.enabled THEN 'disabled'
                     WHEN p.ts IS NULL THEN 'not_polled'
                     WHEN p.ts < now() - GREATEST(interval '60 seconds', d.poll_interval_secs * interval '3 seconds') THEN 'stale'
                     ELSE p.status END AS status,
                p.ts AS last_poll, p.error AS last_error
         FROM devices d
         LEFT JOIN LATERAL (
             SELECT ts, status, error FROM poll_status
             WHERE device_id = d.id ORDER BY ts DESC LIMIT 1
         ) p ON true
         WHERE ($1::bigint IS NULL OR d.id = $1)
         ORDER BY d.name, d.id",
    )
    .bind(id)
    .fetch_all(pool)
    .await
}
 
pub async fn list_devices(
    State(state): State<AppState>,
) -> Result<Json<Vec<DeviceSummary>>, ApiError> {
    Ok(Json(devices(&state.pool, None).await?))
}
 
#[derive(sqlx::FromRow, Serialize)]
pub struct Interface {
    id: i64,
    if_index: i32,
    name: String,
    speed_bps: Option<i64>,
    first_seen: DateTime<Utc>,
    removed_at: Option<DateTime<Utc>>,
}
 
#[derive(sqlx::FromRow, Serialize)]
pub struct Probe {
    protocol: String,
    observed_at: DateTime<Utc>,
    status: String,
    latency_ms: Option<f64>,
    detail: Option<String>,
}
 
#[derive(sqlx::FromRow, Serialize)]
pub struct HardwareSnapshot {
    observed_at: DateTime<Utc>,
    status: String,
    detail: Option<String>,
}
 
#[derive(sqlx::FromRow, Serialize)]
pub struct HardwareComponent {
    entity_index: i32,
    kind: String,
    name: String,
    status: Option<String>,
    value: Option<f64>,
    observed_at: DateTime<Utc>,
}
 
#[derive(Serialize)]
pub struct DeviceDetail {
    device: DeviceSummary,
    interfaces: Vec<Interface>,
    probes: Vec<Probe>,
    hardware: Option<HardwareSnapshot>,
    components: Vec<HardwareComponent>,
}
 
pub async fn device_detail(
    State(state): State<AppState>,
    Path(id): Path<i64>,
) -> Result<Json<DeviceDetail>, ApiError> {
    let device = devices(&state.pool, Some(id))
        .await?
        .into_iter()
        .next()
        .ok_or_else(|| ApiError::new(StatusCode::NOT_FOUND, "device not found"))?;
    let interfaces = sqlx::query_as(
        "SELECT id, if_index, name, speed_bps, first_seen, removed_at FROM interfaces
         WHERE device_id = $1 ORDER BY removed_at NULLS FIRST, if_index",
    )
    .bind(id)
    .fetch_all(&state.pool)
    .await?;
    let probes = sqlx::query_as(
        "SELECT DISTINCT ON (protocol) protocol, observed_at, status, latency_ms, detail
         FROM device_probe_results WHERE device_id = $1 ORDER BY protocol, observed_at DESC, id DESC",
    ).bind(id).fetch_all(&state.pool).await?;
    let hardware = sqlx::query_as(
        "SELECT observed_at, status, detail FROM hardware_snapshot WHERE device_id = $1",
    )
    .bind(id)
    .fetch_optional(&state.pool)
    .await?;
    let components = sqlx::query_as("SELECT entity_index, kind, name, status, value, observed_at FROM hardware_components WHERE device_id = $1 ORDER BY kind, entity_index")
        .bind(id).fetch_all(&state.pool).await?;
    Ok(Json(DeviceDetail {
        device,
        interfaces,
        probes,
        hardware,
        components,
    }))
}
 
#[derive(Deserialize)]
pub struct RangeQuery {
    device: i64,
    interface: Option<i64>,
    from: DateTime<Utc>,
    to: DateTime<Utc>,
}
 
#[derive(Serialize)]
pub struct SeriesResponse {
    source: &'static str,
    unit: &'static str,
    processed_through: Option<DateTime<Utc>>,
    points: Vec<MetricPoint>,
}
 
async fn series(
    state: &AppState,
    query: RangeQuery,
    kind: SeriesKind,
) -> Result<Json<SeriesResponse>, ApiError> {
    if query.device <= 0 || query.from >= query.to || query.to - query.from > Duration::days(1826) {
        return Err(ApiError::new(
            StatusCode::UNPROCESSABLE_ENTITY,
            "invalid device or time range (maximum five years)",
        ));
    }
    let interface = if !matches!(kind, SeriesKind::Resources) {
        query.interface.filter(|id| *id > 0).ok_or_else(|| {
            ApiError::new(StatusCode::UNPROCESSABLE_ENTITY, "interface is required")
        })?
    } else {
        0
    };
    let exists: bool = if !matches!(kind, SeriesKind::Resources) {
        sqlx::query_scalar(
            "SELECT EXISTS(SELECT 1 FROM interfaces WHERE device_id = $1 AND id = $2)",
        )
        .bind(query.device)
        .bind(interface)
        .fetch_one(&state.pool)
        .await?
    } else {
        sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM devices WHERE id = $1)")
            .bind(query.device)
            .fetch_one(&state.pool)
            .await?
    };
    if !exists {
        return Err(ApiError::new(
            StatusCode::NOT_FOUND,
            "device or interface not found",
        ));
    }
    let (source, points) = metrics::series(
        &state.pool,
        query.device,
        interface,
        query.from,
        query.to,
        kind,
    )
    .await?;
    let processed_through = if source == metrics::Source::Raw {
        None
    } else {
        sqlx::query_scalar("SELECT last_rolled_up_at FROM rollup_state WHERE granularity = $1")
            .bind(source.name())
            .fetch_one(&state.pool)
            .await?
    };
    Ok(Json(SeriesResponse {
        source: source.name(),
        unit: match kind {
            SeriesKind::Traffic => "bits/s",
            SeriesKind::Resources => "%",
            SeriesKind::InterfaceHealth => "mixed",
        },
        processed_through,
        points,
    }))
}
 
pub async fn traffic(
    State(state): State<AppState>,
    Query(query): Query<RangeQuery>,
) -> Result<Json<SeriesResponse>, ApiError> {
    series(&state, query, SeriesKind::Traffic).await
}
 
pub async fn resources(
    State(state): State<AppState>,
    Query(query): Query<RangeQuery>,
) -> Result<Json<SeriesResponse>, ApiError> {
    series(&state, query, SeriesKind::Resources).await
}
 
pub async fn interface_health(
    State(state): State<AppState>,
    Query(query): Query<RangeQuery>,
) -> Result<Json<SeriesResponse>, ApiError> {
    series(&state, query, SeriesKind::InterfaceHealth).await
}
 
#[derive(Serialize)]
pub struct FleetStatus {
    total: usize,
    ok: usize,
    partial: usize,
    error: usize,
    stale: usize,
    not_polled: usize,
    disabled: usize,
}
 
pub async fn status(State(state): State<AppState>) -> Result<Json<FleetStatus>, ApiError> {
    let list = devices(&state.pool, None).await?;
    let mut result = FleetStatus {
        total: list.len(),
        ok: 0,
        partial: 0,
        error: 0,
        stale: 0,
        not_polled: 0,
        disabled: 0,
    };
    for device in list {
        match device.status.as_str() {
            "ok" => result.ok += 1,
            "partial" => result.partial += 1,
            "error" => result.error += 1,
            "stale" => result.stale += 1,
            "not_polled" => result.not_polled += 1,
            "disabled" => result.disabled += 1,
            other => {
                return Err(ApiError::internal(format!(
                    "unexpected poll status: {other}"
                )))
            }
        }
    }
    Ok(Json(result))
}
 
#[derive(sqlx::FromRow)]
struct LoadRow {
    device_id: i64,
    forwarding: Option<f64>,
    cpu_pct: Option<f64>,
    memory_pct: Option<f64>,
    in_bps: Option<f64>,
    out_bps: Option<f64>,
    ports_total: i64,
    ports_up: i64,
    ports_down: i64,
}
 
#[derive(Serialize)]
pub struct SwitchOverview {
    #[serde(flatten)]
    device: DeviceSummary,
    /// ipForwarding: 1 = layer 3 (routing), 2 = layer 2 (switching), None = unknown.
    forwarding: Option<f64>,
    /// True when the device has samples in the last 5 minutes.
    sampled: bool,
    cpu_pct: Option<f64>,
    memory_pct: Option<f64>,
    in_bps: Option<f64>,
    out_bps: Option<f64>,
    ports_total: i64,
    ports_up: i64,
    ports_down: i64,
}
 
/// Latest-state summary per device over the last 5 minutes of raw samples.
/// CPU and memory are averaged. Traffic is the sum over interfaces of the
/// average counter rate (delta / elapsed seconds), converted to bits per second.
/// Port state uses the most recent ifOperStatus per interface: 1 is up, 2 and 7 are down.
const OVERVIEW_SQL: &str = r#"
WITH recent AS (
    SELECT s.device_id, s.interface_id, m.name, s.value, s.delta, s.dt_seconds, s.ts
    FROM raw_samples s
    JOIN metrics_catalog m ON m.id = s.metric_id
    WHERE s.ts > now() - interval '5 minutes'
      AND m.name IN ('cpu_5min_pct', 'cpu_load_pct', 'memory_used_pct',
                     'if_hc_in_octets', 'if_hc_out_octets', 'if_oper_status', 'ip_forwarding')
),
cpu AS (
    SELECT device_id, avg(value) AS cpu_pct
    FROM recent
    WHERE name IN ('cpu_5min_pct', 'cpu_load_pct')
    GROUP BY device_id
),
mem AS (
    SELECT device_id, avg(value) AS memory_pct
    FROM recent
    WHERE name = 'memory_used_pct'
    GROUP BY device_id
),
traffic AS (
    SELECT device_id,
           sum(rate) FILTER (WHERE name = 'if_hc_in_octets') * 8 AS in_bps,
           sum(rate) FILTER (WHERE name = 'if_hc_out_octets') * 8 AS out_bps
    FROM (
        SELECT device_id, interface_id, name,
               avg(delta / NULLIF(dt_seconds, 0)) AS rate
        FROM recent
        WHERE name IN ('if_hc_in_octets', 'if_hc_out_octets')
          AND delta IS NOT NULL
          AND interface_id <> 0
        GROUP BY device_id, interface_id, name
    ) per_interface
    GROUP BY device_id
),
fwd AS (
    SELECT device_id, avg(value) AS forwarding
    FROM recent
    WHERE name = 'ip_forwarding'
    GROUP BY device_id
),
ports AS (
    SELECT device_id,
           count(*) AS ports_total,
           count(*) FILTER (WHERE value = 1) AS ports_up,
           count(*) FILTER (WHERE value IN (2, 7)) AS ports_down
    FROM (
        SELECT DISTINCT ON (device_id, interface_id) device_id, interface_id, value
        FROM recent
        WHERE name = 'if_oper_status'
          AND interface_id <> 0
        ORDER BY device_id, interface_id, ts DESC
    ) latest
    GROUP BY device_id
)
SELECT d.id AS device_id,
       cpu.cpu_pct,
       mem.memory_pct,
       traffic.in_bps,
       traffic.out_bps,
       COALESCE(ports.ports_total, 0) AS ports_total,
       COALESCE(ports.ports_up, 0) AS ports_up,
       COALESCE(ports.ports_down, 0) AS ports_down,
       fwd.forwarding
FROM devices d
LEFT JOIN cpu ON cpu.device_id = d.id
LEFT JOIN mem ON mem.device_id = d.id
LEFT JOIN traffic ON traffic.device_id = d.id
LEFT JOIN fwd ON fwd.device_id = d.id
LEFT JOIN ports ON ports.device_id = d.id
"#;
 
pub async fn overview(
    State(state): State<AppState>,
) -> Result<Json<Vec<SwitchOverview>>, ApiError> {
    let list = devices(&state.pool, None).await?;
    let loads: Vec<LoadRow> = sqlx::query_as(OVERVIEW_SQL).fetch_all(&state.pool).await?;
    let mut by_device: HashMap<i64, LoadRow> = loads
        .into_iter()
        .map(|row| (row.device_id, row))
        .collect();
 
    let result = list
        .into_iter()
        .map(|device| match by_device.remove(&device.id) {
            Some(load) => SwitchOverview {
                device,
                forwarding: load.forwarding,
                sampled: true,
                cpu_pct: load.cpu_pct,
                memory_pct: load.memory_pct,
                in_bps: load.in_bps,
                out_bps: load.out_bps,
                ports_total: load.ports_total,
                ports_up: load.ports_up,
                ports_down: load.ports_down,
            },
            None => SwitchOverview {
                device,
                forwarding: None,
                sampled: false,
                cpu_pct: None,
                memory_pct: None,
                in_bps: None,
                out_bps: None,
                ports_total: 0,
                ports_up: 0,
                ports_down: 0,
            },
        })
        .collect();
 
    Ok(Json(result))
}
 

#[derive(Deserialize)]
pub struct MacQuery {
    device: i64,
    interface: i64,
}

#[derive(sqlx::FromRow, Serialize)]
pub struct MacEntry {
    mac: String,
    last_seen: DateTime<Utc>,
}

/// MAC addresses learned on one port (default VLAN only).
pub async fn interface_macs(
    State(state): State<AppState>,
    Query(query): Query<MacQuery>,
) -> Result<Json<Vec<MacEntry>>, ApiError> {
    let rows: Vec<MacEntry> = sqlx::query_as(
        "SELECT mac, last_seen FROM mac_table WHERE device_id = $1 AND interface_id = $2 ORDER BY mac",
    )
    .bind(query.device)
    .bind(query.interface)
    .fetch_all(&state.pool)
    .await?;
    Ok(Json(rows))
}
