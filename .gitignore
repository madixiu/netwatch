# ---- Rust build output ----
target/
**/*.rs.bk

# Keep Cargo.lock committed: poller and api are binaries, and the lock keeps builds reproducible.

# ---- Frontend (web/: React + Vite + Tailwind) ----
web/node_modules/
web/dist/
web/.vite/
web/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Secrets and keys: never commit ----
*.key
secret.key
*.pem
*.p12
*.pfx
*.jks
deploy/certs/private/
.env
.env.*
!.env.example

# ---- Local runtime data ----
*.log
logs/
*.sqlite
*.db
pgdata/

# ---- Exports and scratch ----
*.zip
tree.txt

# ---- Editors and OS files ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
